# ==================== UTILITY FUNCTIONS ====================

class Color:
    """Color management for terminal output"""
    def __init__(self):
        self.enabled = COLORAMA_AVAILABLE
    
    def header(self, text):
        if self.enabled:
            return f"{Fore.CYAN}{Back.BLACK}{text}{Style.RESET_ALL}"
        return text
    
    def success(self, text):
        if self.enabled:
            return f"{Fore.GREEN}{text}{Style.RESET_ALL}"
        return text
    
    def warning(self, text):
        if self.enabled:
            return f"{Fore.YELLOW}{text}{Style.RESET_ALL}"
        return text
    
    def error(self, text):
        if self.enabled:
            return f"{Fore.RED}{text}{Style.RESET_ALL}"
        return text
    
    def info(self, text):
        if self.enabled:
            return f"{Fore.BLUE}{text}{Style.RESET_ALL}"
        return text

color = Color()

class DataManager:
    """Save and load calculations to/from JSON"""
    def __init__(self, filename="calculations_history.json"):
        self.filename = filename
        self.data = self.load()
    
    def load(self):
        try:
            if os.path.exists(self.filename):
                with open(self.filename, 'r') as f:
                    return json.load(f)
        except:
            pass
        return {"calculations": []}
    
    def save_calculation(self, category, calculation_type, inputs, outputs):
        """Save a calculation to history"""
        entry = {
            "timestamp": datetime.now().isoformat(),
            "category": category,
            "type": calculation_type,
            "inputs": inputs,
            "outputs": outputs
        }
        self.data["calculations"].append(entry)
        self.save()
    
    def save(self):
        try:
            with open(self.filename, 'w') as f:
                json.dump(self.data, f, indent=2)
            print(color.success(f"✓ Calculation saved to {self.filename}"))
        except:
            print(color.error("✗ Failed to save calculation"))
    
    def show_history(self):
        """Display calculation history"""
        if not self.data["calculations"]:
            print(color.warning("No calculations in history"))
            return
        
        print(color.header("\n" + "="*60))
        print(color.header("CALCULATION HISTORY"))
        print(color.header("="*60))
        
        for i, calc in enumerate(self.data["calculations"][-10:], 1):
            print(f"\n{i}. {calc['type']} ({calc['category']})")
            print(f"   Time: {calc['timestamp']}")
            print(f"   Inputs: {calc['inputs']}")
            print(f"   Outputs: {calc['outputs']}")

data_manager = DataManager()

def plot_function(func, x_range, title, xlabel, ylabel):
    """Plot a mathematical function"""
    if not MATPLOTLIB_AVAILABLE:
        print(color.warning("Matplotlib not available. Install with: pip install matplotlib"))
        return
    
    x = np.linspace(x_range[0], x_range[1], 500)
    y = [func(xi) for xi in x]
    
    plt.figure(figsize=(10, 6))
    plt.plot(x, y, 'b-', linewidth=2)
    plt.title(title, fontsize=14, fontweight='bold')
    plt.xlabel(xlabel)
    plt.ylabel(ylabel)
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.show()

