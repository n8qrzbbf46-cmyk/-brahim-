                x = float(input("Value x: "))
                
                from scipy.stats import norm
                pdf = norm.pdf(x, mu, sigma)
                cdf = norm.cdf(x, mu, sigma)
                
                print(color.success(f"\n✓ P(X=x) = {pdf:.6f}"))
                print(f"  P(X≤x) = {cdf:.6f}"))
        
        elif choice == "3":
            print(color.info("\n--- Linear Regression ---"))
            n = int(input("Number of data points: "))
            x_data = []
            y_data = []
            
            for i in range(n):
                x = float(input(f"x_{i+1}: "))
                y = float(input(f"y_{i+1}: "))
                x_data.append(x)
                y_data.append(y)
            
            x_data = np.array(x_data)
            y_data = np.array(y_data)
            
            slope, intercept = np.polyfit(x_data, y_data, 1)
            r_squared = 1 - (np.sum((y_data - (slope*x_data + intercept))**2) / np.sum((y_data - np.mean(y_data))**2))
            
