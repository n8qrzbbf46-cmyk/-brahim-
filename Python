                                             {"v/c": v_fraction}, {"gamma": gamma})
            else:
                print(color.error("Velocity must be between 0 and 1 (not including light speed)."))
        
        elif choice == "2":
            v_fraction = float(input("Enter velocity as fraction of c: "))
            if 0 <= v_fraction < 1:
                L0 = float(input("Rest length (m): "))
                gamma = 1 / math.sqrt(1 - v_fraction ** 2)
                L = L0 / gamma
                print(color.success(f"\n✓ Contracted length = {L:.4f} m"))
                print(f"  Contraction: {(1 - L/L0)*100:.2f}%")
                data_manager.save_calculation("Physics", "Length Contraction", 
                                             {"L0": L0, "v/c": v_fraction}, {"L": L})
        
        elif choice == "3":
            m = float(input("Mass (kg): "))
            c = 3e8
            E = m * c**2
            print(color.success(f"\n✓ Energy = {E:.2e} J"))
            print(f"  Energy = {E/1.602e-19:.2e} eV")
            data_manager.save_calculation("Physics", "Mass-Energy", {"m": m}, {"E": E})
        
        elif choice == "4":
            v_fraction = float(input("Enter velocity as fraction of c: "))
            if 0 <= v_fraction < 1:
                m = float(input("Rest mass (kg): "))
                c = 3e8
                v = v_fraction * c
                gamma = 1 / math.sqrt(1 - v_fraction ** 2)
                KE_rel = (gamma - 1) * m * c**2
                print(color.success(f"\n✓ Relativistic KE = {KE_rel:.2e} J"))
                data_manager.save_calculation("Physics", "Relativistic KE", 
                                             {"m": m, "v/c": v_fraction}, {"KE": KE_rel})
    except ValueError:
        print(color.error("Invalid input."))


