                print(color.success(f"\n✓ Angle for {m} order fringe = {theta:.2f}°"))
                data_manager.save_calculation("Physics", "Double Slit", 
                                             {"λ": wavelength, "d": d, "m": m}, {"θ": theta})
            else:
                print(color.error("sin(θ) > 1: This fringe order doesn't exist"))
        
        elif choice == "2":
            print(color.info("\n--- Single Slit Diffraction ---"))
            print("Dark fringes: m·λ = a·sin(θ)")
            wavelength = float(input("Wavelength (m): "))
            a = float(input("Slit width (m): "))
            m = int(input("Order of dark fringe (m): "))
            
            sin_theta = (m * wavelength) / a
            if abs(sin_theta) <= 1:
                theta = math.degrees(math.asin(sin_theta))
                print(color.success(f"\n✓ Angle for dark fringe {m} = {theta:.2f}°"))
                data_manager.save_calculation("Physics", "Single Slit", 
                                             {"λ": wavelength, "a": a, "m": m}, {"θ": theta})
        
        elif choice == "3":
            print(color.info("\n--- Lens Formula (1/f = 1/u + 1/v) ---"))
            print("1. Find focal length")
            print("2. Find image distance")
            print("3. Find object distance")
            sub = input("Choose: ").strip()
            
            if sub == "1":
                u = float(input("Object distance (cm): "))
                v = float(input("Image distance (cm): "))
                f = 1 / (1/u + 1/v)
                print(color.success(f"✓ Focal length = {f:.2f} cm"))
                data_manager.save_calculation("Physics", "Lens Formula", 
                                             {"u": u, "v": v}, {"f": f})
            elif sub == "2":
                f = float(input("Focal length (cm): "))
                u = float(input("Object distance (cm): "))
                v = 1 / (1/f - 1/u)
                print(color.success(f"✓ Image distance = {v:.2f} cm"))
                data_manager.save_calculation("Physics", "Lens Formula", 
                                             {"f": f, "u": u}, {"v": v})
        
        elif choice == "4":
            print(color.info("\n--- Snell's Law (n₁ sin θ₁ = n₂ sin θ₂) ---"))
            n1 = float(input("Refractive index 1: "))
            theta1 = float(input("Angle 1 (degrees): "))
            n2 = float(input("Refractive index 2: "))
            
            sin_theta2 = (n1 * math.sin(math.radians(theta1))) / n2
            if abs(sin_theta2) <= 1:
                theta2 = math.degrees(math.asin(sin_theta2))
                print(color.success(f"\n✓ Refracted angle = {theta2:.2f}°"))
                data_manager.save_calculation("Physics", "Snell's Law", 
                                             {"n1": n1, "θ1": theta1, "n2": n2}, {"θ2": theta2})
            else:
                print(color.warning("Total internal reflection occurs!"))
    except ValueError:
        print(color.error("Invalid input."))


