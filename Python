    print("4. Snell's Law (Refraction)")
    print("5. Back")
    
    choice = input(color.info("\nSelect: ")).strip()
    
    try:
        if choice == "1":
            print(color.info("\n--- Double Slit Interference ---"))
            print("Bright fringes: m·λ = d·sin(θ)")
            wavelength = float(input("Wavelength (m): "))
            d = float(input("Slit separation (m): "))
