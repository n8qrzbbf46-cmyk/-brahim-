def linear_algebra_tool():
    print("\n--- Linear Algebra Solver (Ax = b) ---")
    print("Using NumPy + SciPy (very fast and accurate)")
    try:
        n = int(input("Matrix size (e.g. 3 for 3x3): "))
        print("Enter matrix A row by row (space separated):")
        A = []
        for i in range(n):
            row = list(map(float, input(f"Row {i+1}: ").split()))
            A.append(row)
        A = np.array(A)

        print("Enter vector b:")
        b = np.array(list(map(float, input().split())))

        x = np.linalg.solve(A, b)
        print("\nSolution x:")
        print(x)
    except Exception as e:
        print(f"Error: {e}")


def numerical_integration_tool():
    print("\n--- Numerical Integration ---")
    print("Using SciPy.integrate")
    print("Example: Integrate sin(x) from 0 to pi")
    result, _ = integrate.quad(lambda x: math.sin(x), 0, math.pi)
    print(f"Result = {result:.6f} (should be close to 2.0)")


def optimization_tool():
    print("\n--- Optimization / Root Finding ---")
    print("Using SciPy.optimize")
    print("Example: Find root of x^2 - 2 = 0")
    root = optimize.root_scalar(lambda x: x**2 - 2, bracket=[1, 2])
    print(f"Root ≈ {root.root:.6f}")


def symbolic_math_tool():
    print("\n--- Symbolic Mathematics (SymPy) ---")
    x = sp.symbols('x')
    expr = sp.sin(x)**2 + sp.cos(x)**2
    simplified = sp.simplify(expr)
    print(f"Simplified: {simplified}  (should be 1)")


