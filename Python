def linear_algebra_tool():
    print(color.header("\n--- Linear Algebra Solver (Ax = b) ---"))
    print("Using NumPy + SciPy (very fast and accurate)")
    try:
        n = int(input("Matrix size (e.g. 3 for 3x3): "))
        print("Enter matrix A row by row (space separated):")
        A = []
        for i in range(n):
            row = list(map(float, input(f"Row {i+1}: ").split()))
            A.append(row)
        A = np.array(A)

        print("Enter vector b (space separated):")
        b = np.array(list(map(float, input().split())))

        x = np.linalg.solve(A, b)
        print(color.success("\n✓ Solution x:"))
        print(x)
        
        # Also calculate determinant and condition number
        det_A = np.linalg.det(A)
        cond = np.linalg.cond(A)
        
        print(f"\nMatrix determinant: {det_A:.6f}")
        print(f"Condition number: {cond:.2f}")
        
        data_manager.save_calculation("Mathematics", "Linear System", 
                                     {"matrix_size": n}, 
                                     {"solution": x.tolist(), "determinant": det_A})
    except Exception as e:
        print(color.error(f"Error: {e}"))


