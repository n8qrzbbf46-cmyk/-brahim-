        elif choice == "4":
            print(color.info("\n--- Binding Energy (BE = Δm c²) ---"))
            Z = int(input("Number of protons (Z): "))
            A = int(input("Mass number (A): "))
            M_nucleus = float(input("Nuclear mass (u): "))
            
            m_p = 1.007276  # proton mass in u
            m_n = 1.008665  # neutron mass in u
            u_to_MeV = 931.5  # conversion factor
            
            N = A - Z
            M_expected = Z * m_p + N * m_n
            delta_m = M_expected - M_nucleus
            BE = delta_m * u_to_MeV
            
            print(color.success(f"\n✓ Binding Energy = {BE:.2f} MeV"))
            print(f"  Binding Energy per nucleon = {BE/A:.2f} MeV/nucleon")
            data_manager.save_calculation("Nuclear", "Binding Energy", 
                                         {"Z": Z, "A": A}, {"BE": BE})
