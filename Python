    print("4. Thermodynamic Properties")
    print("5. Back")
    choice = input(color.info("\nChoose: ")).strip()

    try:
        if choice == "1":
            print(color.info("\n--- Arrhenius Equation (k = A e^(-Ea/RT)) ---"))
            Ea = float(input("Activation energy Ea (kJ/mol): "))
            T = float(input("Temperature T (K): "))
            A = float(input("Pre-exponential factor A: "))
            R = 8.314
            
            Ea_J = Ea * 1000
            k = A * math.exp(-Ea_J / (R * T))
            print(color.success(f"\n✓ Reaction rate constant k = {k:.6e}"))
            data_manager.save_calculation("Chemistry", "Arrhenius Equation", 
                                         {"Ea": Ea, "T": T, "A": A}, {"k": k})
        
        elif choice == "2":
            print(color.info("\n--- Chemical Equilibrium ---"))
            print("For reaction: aA + bB ⇌ cC + dD")
            conc_C = float(input("Concentration of C (M): "))
            power_C = int(input("Power of C (c): "))
            conc_D = float(input("Concentration of D (M): "))
            power_D = int(input("Power of D (d): "))
            conc_A = float(input("Concentration of A (M): "))
            power_A = int(input("Power of A (a): "))
            conc_B = float(input("Concentration of B (M): "))
            power_B = int(input("Power of B (b): "))
            
            Ke = (conc_C**power_C * conc_D**power_D) / (conc_A**power_A * conc_B**power_B)
            print(color.success(f"\n✓ Equilibrium Constant Ke = {Ke:.6e}"))
            data_manager.save_calculation("Chemistry", "Equilibrium Constant", 
                                         {"products": [conc_C, conc_D], "reactants": [conc_A, conc_B]}, 
                                         {"Ke": Ke})
        
        elif choice == "3":
            print(color.info("\n--- Henderson-Hasselbalch Equation ---"))
