def projectile_motion():
    print(color.info("\n--- Projectile Motion Calculator ---"))
    try:
        v0 = float(input("Enter initial velocity (m/s): "))
        angle_deg = float(input("Enter launch angle (degrees): "))
        g = 9.81

        angle_rad = math.radians(angle_deg)
        
        # Basic calculations
        range_no_drag = (v0 ** 2 * math.sin(2 * angle_rad)) / g
        max_height = (v0 ** 2 * math.sin(angle_rad) ** 2) / (2 * g)
        time_flight = (2 * v0 * math.sin(angle_rad)) / g
        
        print(color.success(f"\n✓ RESULTS:"))
        print(f"  Maximum Range: {range_no_drag:.2f} m")
        print(f"  Maximum Height: {max_height:.2f} m")
        print(f"  Flight Time: {time_flight:.2f} s")
        
        inputs = {"velocity": v0, "angle": angle_deg}
        outputs = {"range": range_no_drag, "height": max_height, "time": time_flight}
        data_manager.save_calculation("Physics", "Projectile Motion", inputs, outputs)
        
        # Optional visualization
        if MATPLOTLIB_AVAILABLE:
            plot_trajectory = input("Plot trajectory? (y/n): ").lower()
            if plot_trajectory == 'y':
                t = np.linspace(0, time_flight, 100)
                x = v0 * np.cos(angle_rad) * t
                y = v0 * np.sin(angle_rad) * t - 0.5 * g * t**2
                
                plt.figure(figsize=(10, 6))
                plt.plot(x, y, 'b-', linewidth=2, label='Trajectory')
                plt.scatter([range_no_drag], [0], color='r', s=100, label='Landing point')
                plt.scatter([range_no_drag/2], [max_height], color='g', s=100, label='Max height')
                plt.xlabel('Distance (m)', fontsize=12)
                plt.ylabel('Height (m)', fontsize=12)
                plt.title(f'Projectile Motion (v₀={v0} m/s, θ={angle_deg}°)', fontsize=14, fontweight='bold')
                plt.grid(True, alpha=0.3)
                plt.legend()
                plt.tight_layout()
                plt.show()
    except ValueError:
        print(color.error("Invalid input. Please enter numbers only."))


