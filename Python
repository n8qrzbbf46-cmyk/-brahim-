def bohr_model():
    print(color.header("\n--- Bohr Model Calculations ---"))
    print("For hydrogen-like atoms: E_n = -13.6 eV × Z² / n²")
    print("Orbit radius: r_n = 0.529 Å × n² / Z")
    
    try:
        Z = int(input("Atomic number Z (protons): "))
        n = int(input("Principal quantum number n: "))
        
        # Energy level
        E_n = -13.6 * (Z**2) / (n**2)
        
        # Bohr radius
        a0 = 0.529e-10  # Bohr radius in meters
        r_n = a0 * (n**2) / Z
        
        # Frequency of emitted photon (for transition to lower level)
        print(f"\n{color.success('✓ BOHR MODEL RESULTS:')}")
        print(f"  Energy of orbit {n}: {E_n:.2f} eV")
        print(f"  Orbital radius: {r_n:.2e} m = {r_n*1e10:.3f} Å")
        print(f"  Velocity in orbit: {2.187e6 * Z / n:.2e} m/s")
        
        # Transition energy
        if n > 1:
            n_final = n - 1
            E_final = -13.6 * (Z**2) / (n_final**2)
            delta_E = E_n - E_final
            freq = abs(delta_E) * 1.602e-19 / 6.626e-34
            wavelength = 3e8 / freq
            
            print(f"\n  Transition to n={n_final}:")
            print(f"    Photon energy: {abs(delta_E):.2f} eV")
            print(f"    Frequency: {freq:.2e} Hz")
            print(f"    Wavelength: {wavelength:.2e} m")
        
        data_manager.save_calculation("Atomic", "Bohr Model", 
                                     {"Z": Z, "n": n}, 
                                     {"E_n": E_n, "r_n": r_n})
    except ValueError:
        print(color.error("Invalid input."))


